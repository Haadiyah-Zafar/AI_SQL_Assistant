# Copy to backend/.env and fill in values for local development.
# cp backend/.env.example backend/.env

APP_NAME=Agentic SQL Copilot
APP_VERSION=0.1.0

# Required for SQL generation via Groq
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# Local paths (relative to backend/ when running uvicorn)
UPLOAD_DIR=data/uploads
CHROMA_PERSIST_DIR=data/chroma

# Static frontend served on port 8080 by scripts/start_frontend.ps1
CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080,http://localhost:3000,http://127.0.0.1:3000
